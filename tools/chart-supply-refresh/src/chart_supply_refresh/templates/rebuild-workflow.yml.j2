# Auto-generated by chart-supply-refresh {{ tool_version }}.
# Rebuilds the chart's forkable Dockerfiles on a cron, against the
# current-stable base OS images. Each successful build pushes to:
#   {{ target_registry }}/<image>-rebuilt:<upstream-tag>-rebuilt-<YYYYMMDD>
name: rebuild-supply-chain

on:
  workflow_dispatch: {}
  schedule:
    - cron: '{{ cron }}'

permissions:
  contents: read
  packages: write

jobs:
  rebuild:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
{%- for entry in matrix %}
          - image: {{ entry.image }}
            dockerfile: dockerfiles/{{ entry.image }}/Dockerfile
            upstream-tag: {{ entry.upstream_tag }}
{%- endfor %}
    steps:
      - uses: actions/checkout@v4
      - id: date
        run: echo "value=$(date -u +%Y%m%d)" >> $GITHUB_OUTPUT
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: {{ registry_host }}
          username: {{ gha.actor }}
          password: {{ gha.token }}
      - uses: docker/build-push-action@v6
        with:
          context: ./dockerfiles/{{ gha.matrix_image }}
          file: ./{{ gha.matrix_dockerfile }}
          push: true
          tags: |
            {{ target_registry }}/{{ gha.matrix_image }}-rebuilt:{{ gha.matrix_upstream_tag }}-rebuilt-{{ gha.date_value }}
